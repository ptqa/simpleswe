{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "not": { "const": "latest" } },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "controller": {
          "type": "object",
          "properties": {
            "listen_address": { "type": "string", "pattern": ".*\\S.*" },
            "webhook_listen_address": { "const": ":8081" }
          }
        },
        "bitbucket": {
          "type": "object",
          "properties": {
            "webhook_secret": { "$ref": "#/definitions/bitbucketWebhookSecretSource" }
          }
        },
        "github": {
          "type": "object",
          "properties": {
            "webhook_secret": { "$ref": "#/definitions/githubWebhookSecretSource" }
          }
        },
        "repositories": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/repository" }
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "webhooks": {
          "type": "object",
          "required": ["name", "keys"],
          "properties": {
            "name": { "$ref": "#/definitions/kubernetesName" },
            "keys": {
              "type": "object",
              "required": ["github", "bitbucket"],
              "properties": {
                "github": { "type": "string", "minLength": 1 },
                "bitbucket": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "trustedIngress", "webhookIngress", "httpsCIDRs", "repositoryEgress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "trustedIngress": {
          "type": "array",
          "items": { "$ref": "#/definitions/networkPolicyPeer" }
        },
        "webhookIngress": {
          "type": "array",
          "items": { "$ref": "#/definitions/networkPolicyPeer" }
        },
        "httpsCIDRs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "repositoryEgress": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    }
  },
  "definitions": {
    "githubWebhookSecretSource": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": { "const": "/run/secrets/webhooks/github" }
      },
      "additionalProperties": false
    },
    "bitbucketWebhookSecretSource": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": { "const": "/run/secrets/webhooks/bitbucket" }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "oneOf": [
        { "required": ["bitbucket"], "not": { "required": ["github"] } },
        { "required": ["github"], "not": { "required": ["bitbucket"] } }
      ],
      "properties": {
        "bitbucket": {
          "type": "object",
          "required": ["workspace", "repository", "credentials_secret_name"],
          "properties": {
            "workspace": { "type": "string", "minLength": 1 },
            "repository": { "type": "string", "minLength": 1 },
            "credentials_secret_name": { "$ref": "#/definitions/kubernetesName" }
          },
          "additionalProperties": false
        },
        "github": {
          "type": "object",
          "required": ["owner", "repository", "credentials_secret_name"],
          "properties": {
            "owner": { "type": "string", "minLength": 1 },
            "repository": { "type": "string", "minLength": 1 },
            "credentials_secret_name": { "$ref": "#/definitions/kubernetesName" }
          },
          "additionalProperties": false
        }
      }
    },
    "kubernetesName": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "networkPolicyPeer": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "ipBlock": { "type": "object" },
        "namespaceSelector": { "type": "object" },
        "podSelector": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
